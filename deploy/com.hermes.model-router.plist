<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd job (macOS). Install:
       cp deploy/com.hermes.model-router.plist ~/Library/LaunchAgents/
       launchctl load -w ~/Library/LaunchAgents/com.hermes.model-router.plist
     Adjust the program path and config location for your install. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.hermes.model-router</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/hermes-model-router</string>
    <string>-c</string>
    <string>/usr/local/etc/hermes-model-router/config.yaml</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/tmp/hermes-model-router.log</string>
</dict>
</plist>
